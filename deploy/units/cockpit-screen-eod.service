[Unit]
Description=SEPA cockpit EOD universe screen (rebuilds the scan table / last_scan.pkl)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ml-trading-pfopt
ExecStart=/usr/bin/docker compose run --rm oneshot python src/stock_screener/cockpit/screen_job.py
# Screening ~4,100 names is the hungriest thing that runs on this box (1.8 GB RAM, and the
# Streamlit app holds ~190 MB of it). Prices come from cache when cockpit-refresh-eod has
# already run, so this is CPU-bound rather than network-bound — but generous, because a
# swapping Pi is slow, not broken, and nothing is scheduled behind it.
TimeoutStartSec=3600
