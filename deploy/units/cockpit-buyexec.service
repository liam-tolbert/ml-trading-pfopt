[Unit]
Description=SEPA cockpit morning armed-entry execute (at most one buy for the open)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ml-trading-pfopt
ExecStart=/usr/bin/docker compose run --rm oneshot python src/stock_screener/cockpit/entry_job.py execute
TimeoutStartSec=600
