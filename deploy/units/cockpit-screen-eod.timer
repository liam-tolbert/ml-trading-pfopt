[Unit]
Description=EOD universe screen, 17:30 ET weekdays

[Timer]
# 17:30, AFTER cockpit-refresh-eod at 17:00 (~11 min for the universe top-up). Ordering is
# load-bearing: run the screen first and it screens yesterday's bars. The gap also means
# every price read here is served from the settled-close cache, so the screen costs no
# network at all.
OnCalendar=Mon..Fri *-*-* 16:25:00 America/New_York
# A missed screen is not replayed overnight — the next weekday's run supersedes it, and the
# app keeps serving the previous scan (correctly labelled with its own date) meanwhile.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
