[Unit]
Description=SEPA cockpit EOD universe price top-up (all scan-universe tickers, post-close)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ml-trading-pfopt
ExecStart=/usr/bin/docker compose run --rm oneshot python src/stock_screener/cockpit/refresh_job.py --scope universe
# ~4,100 names, measured at 11-13 min on a Pi 4 and longer when yfinance throttles.
# Generous because this runs ONCE a day with nothing scheduled behind it — unlike the
# half-hourly watchlist refresh, there is no next fire to protect from a slow run.
TimeoutStartSec=2400
