[Unit]
Description=SEPA cockpit data refresh (universe price top-up + watchlist trigger check)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ml-trading-pfopt
ExecStart=/usr/bin/docker compose run --rm oneshot
# The universe top-up is thousands of names, so this is far longer than the old
# trigger-only 900s — but still SHORTER than the 30-minute timer interval, so a wedged
# run is killed before the next one is due rather than stacking. A killed run is not
# lost work: every ticker's parquet is written as it completes, so the next fire resumes
# from wherever the cache got to.
TimeoutStartSec=1500
