[Unit]
Description=SEPA cockpit intraday refresh (watchlist + held names, then trigger check)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/ml-trading-pfopt
ExecStart=/usr/bin/docker compose run --rm oneshot
# The watchlist scope is tens of names — seconds per run. The universe sweep lives in
# cockpit-refresh-eod.timer instead. Still shorter than the 30-minute interval so a wedged
# run is killed before the next is due rather than stacking; a killed run is not lost
# work, since every ticker's parquet is written as it completes, so the next fire resumes
# from wherever the cache got to.
TimeoutStartSec=900
