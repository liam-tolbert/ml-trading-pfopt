[Unit]
Description=EOD pull-based deploy for the SEPA cockpit (off-hours only)

[Timer]
# Both fires sit outside 09:00-16:30 ET by construction: a mid-session pull
# would change trading behavior mid-day. Push at noon -> lands that evening.
OnCalendar=Mon..Fri *-*-* 17:30:00 America/New_York
OnCalendar=Sat *-*-* 10:00:00 America/New_York
# Catch up after a power cut — deploys are always off-hours anyway.
Persistent=true

[Install]
WantedBy=timers.target
