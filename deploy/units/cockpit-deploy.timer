[Unit]
Description=EOD pull-based deploy for the SEPA cockpit (off-hours only)

[Timer]
# Weekdays: start right at market close (16:30 ET) and repeat every 30 min for the rest of the day.
OnCalendar=Mon..Fri *-*-* 16:30:00
OnCalendar=Mon..Fri *-*-* 17..23:0/30:00
# Weekends: no trading session at all, so run every 30 min around the clock.
OnCalendar=Sat,Sun *-*-* *:0/30:00
# Catch up after a power cut — deploys are always off-hours anyway.
Persistent=true

[Install]
WantedBy=timers.target