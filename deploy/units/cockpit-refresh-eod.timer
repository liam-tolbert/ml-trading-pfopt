[Unit]
Description=EOD universe price top-up, 17:00 ET weekdays

[Timer]
# 17:00, not 16:30: the bar settles ~16:05, and a 12-minute sweep started at 16:30 would
# run straight across cockpit-sellplan at 16:40 — two containers hitting yfinance at once
# is what produced the "database is locked" failures on 2026-08-26. By 17:00 the settled
# close is in and the evening ritual is done, and because this run WRITES post-settle it
# arms data_feed._cache_settled: every read after it costs zero network until the open.
OnCalendar=Mon..Fri *-*-* 16:20:00 America/New_York
# A missed EOD sweep is not replayed at 02:00 — the next weekday's run covers it, and the
# stale cache is still served correctly (just older) in the meantime.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
