[Unit]
Description=EOD universe sweep + screen, 16:20 ET weekdays

[Timer]
# 16:20: after the ~16:05 bar settle, and clear of cockpit-sellplan at 16:15 (an 18-second
# job). The screen no longer needs a slot of its own — it is the second ExecStart of this
# same unit, so it follows the sweep's actual finish instead of a guessed clock offset.
OnCalendar=Mon..Fri *-*-* 16:20:00 America/New_York
# A missed EOD run is not replayed at 02:00 — the next weekday's run covers it. The stale
# cache is still served correctly (just older) meanwhile, and the app keeps showing the
# previous scan under its own date.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
