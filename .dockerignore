# Whitelist (BuildKit): ignore everything, re-include the cockpit closure.
# Keeps data/, .git, notebooks, docs/, the legacy ML pipeline and the parked
# research tracks out of the image by construction.
*

!.streamlit/config.toml
!deploy/requirements.txt

# --- cockpit app ---
!src/stock_screener/cockpit/**
!src/stock_screener/minervini_sepa_system.md

# --- vendored pure rule modules + attribution (these four are the whole of the
#     vendored package now; the live-fetch layers were deleted, see PROVENANCE) ---
!src/stock_screener/minervini_screener/__init__.py
!src/stock_screener/minervini_screener/LICENSE
!src/stock_screener/minervini_screener/PROVENANCE.md
!src/stock_screener/minervini_screener/screening/__init__.py
!src/stock_screener/minervini_screener/screening/phase_indicators.py
!src/stock_screener/minervini_screener/screening/signal_engine.py
!src/stock_screener/minervini_screener/screening/benchmark.py
!src/stock_screener/minervini_screener/screening/indicators.py

# --- trade panel dependency (lazy import in cockpit/trade.py) ---
!src/portfolio_experimentation/alpaca_trader.py

# --- test-gate closure: the cockpit suites build their offline price fixture from
#     backtest_daily.synthetic_provider. Its FULL closure is these four files
#     (synthetic_provider -> providers -> fundamentals_adapter; numpy/pandas only).
#     Listed one by one, NOT as a glob: the package __init__ re-exports nothing so
#     this import cannot reach engine -> metrics -> momentum_lib +
#     ml_stock_prediction.backtest_lib, and a glob would silently re-admit two parked
#     research tracks to the runtime image the moment that changed. ---
!src/stock_screener/backtest_daily/__init__.py
!src/stock_screener/backtest_daily/providers.py
!src/stock_screener/backtest_daily/fundamentals_adapter.py
!src/stock_screener/backtest_daily/synthetic_provider.py
!tests/test_cockpit.py
# A GLOB, not per-file entries: the cockpit suites are split by category under
# tests/cockpit/, and a new one added to the gate must never need a second edit here.
# That was the §6.61 trap — a suite present in the repo but absent from the image fails
# as "can't open file" rather than as a red test.
!tests/cockpit/**
!tests/vcp_labels.py
!tests/fixtures/vcp_bench/**

# --- weekend-hunt pipeline: gated by deploy.sh, so it must be in the image.
#     pipeline/report are stdlib + pandas + cockpit.cache; charts/__main__ are
#     re-excluded below (matplotlib is not a runtime dep and the hunt's chart
#     rendering runs on the laptop, never on the Pi) ---
!src/stock_screener/hunt/**
!tests/test_hunt.py

# --- re-excludes (last match wins) ---
src/stock_screener/hunt/charts.py
src/stock_screener/hunt/__main__.py
**/__pycache__
**/*.pyc
.env
